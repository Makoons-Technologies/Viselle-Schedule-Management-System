# Staging frontend (Vercel Preview env for the `staging` branch).
# Point at the staging API only — never production API/DB for routine testing.
# Domains: viselle.net (not viselle.app). Staging: staging.viselle.net / staging-api.viselle.net.
# Note: live staging API hostname is staging-api.viselle.net (api-staging.viselle.net is not deployed).

VITE_API_BASE_URL=https://staging-api.viselle.net/api/v1
VITE_CONTACT_EMAIL=hello@viselle.net
VITE_BOOKING_BASE_URL=https://staging.viselle.net
VITE_SITES_BASE_DOMAIN=viselle.net
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PUBLIC_API_DOCS_URL=/docs/api
