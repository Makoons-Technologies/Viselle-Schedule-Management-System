# Playwright end-to-end tests. Copy to .env.e2e (gitignored) — never commit real secrets.
# Production is viselle.net. Do not point these tests at production or use production passwords.

# Local Vite (default in playwright.config.ts). Starts `npm run dev` when the host is localhost.
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Staging UI (non-production). Does not start Vite.
# PLAYWRIGHT_BASE_URL=https://staging.viselle.net

# Non-production login only. Local seed (example — do not commit a real .env):
#   PLAYWRIGHT_EMAIL=owner@test.com
#   PLAYWRIGHT_PASSWORD=password123
PLAYWRIGHT_EMAIL=
PLAYWRIGHT_PASSWORD=

# Optional staff login (used if PLAYWRIGHT_EMAIL / PLAYWRIGHT_PASSWORD are empty).
# PLAYWRIGHT_STAFF_EMAIL=
# PLAYWRIGHT_STAFF_PASSWORD=
