VITE_API_BASE_URL=http://localhost:3001/api/v1
# Production domain is viselle.net (never viselle.app).
VITE_CONTACT_EMAIL=hello@viselle.net
VITE_BOOKING_BASE_URL=http://localhost:5173
# Canonical marketing origin for SEO (og:url, sitemap, JSON-LD). Defaults to VITE_BOOKING_BASE_URL or https://viselle.net.
VITE_SITE_URL=https://viselle.net
VITE_SITES_BASE_DOMAIN=viselle.net
VITE_STRIPE_PUBLISHABLE_KEY=
# Public booking API docs page (no auth). Default is the in-app route /docs/api.
# Set an absolute URL only if you host docs elsewhere.
VITE_PUBLIC_API_DOCS_URL=/docs/api

# End-to-end tests (Playwright) — copy .env.e2e.example to .env.e2e (gitignored).
# Do not put production passwords here. Default target is local Vite, not viselle.net.
# PLAYWRIGHT_BASE_URL=http://localhost:5173
# PLAYWRIGHT_EMAIL=
# PLAYWRIGHT_PASSWORD=
